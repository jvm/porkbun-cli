{
  "name": "porkbun-cli",
  "version": "0.1.1",
  "description": "Agent-friendly CLI for the Porkbun API v3.",
  "keywords": [
    "porkbun",
    "cli",
    "dns",
    "domains",
    "automation",
    "api-client"
  ],
  "author": "Jose Mocito",
  "homepage": "https://github.com/jvm/porkbun-cli#readme",
  "bugs": {
    "url": "https://github.com/jvm/porkbun-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvm/porkbun-cli.git"
  },
  "type": "module",
  "bin": {
    "porkbun": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "SKILL.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/generated && cp src/generated/openapi.json dist/generated/openapi.json && chmod +x dist/cli.js",
    "lint": "eslint src",
    "test": "npm run build && npm run lint && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.0.6",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.39.4",
    "eslint-plugin-security": "^3.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "undici": "^8.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
